# PayPal配置
# 获取步骤：
# 1. 访问 https://developer.paypal.com/dashboard/
# 2. 登录PayPal开发者账号（使用普通PayPal账号登录即可）
# 3. 进入 "Apps & Credentials" → "REST API Apps"
# 4. 点击 "Create App" 创建应用
# 5. 复制 "Client ID" 和 "Client Secret"

# 前端使用的Client ID（可以公开）
VITE_PAYPAL_CLIENT_ID=test_client_id_here

# 后端使用的Client Secret（绝不能泄露，不要提交到git）
PAYPAL_CLIENT_SECRET=test_client_secret_here

# PayPal模式：sandbox（测试）或 live（正式）
PAYPAL_MODE=sandbox

# 服务器端口
PORT=3001
